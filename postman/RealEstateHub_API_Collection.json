{
  "info": {
    "name": "Real Estate Listing and Brokerage Platform API",
    "description": "Comprehensive Postman API collection for Spring Boot backend endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Johnson\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"+1 555-0199\",\n  \"role\": \"ROLE_BUYER\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"buyer@realestate.com\",\n  \"password\": \"buyer123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Current User (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Properties",
      "item": [
        {
          "name": "Search & Filter Properties",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/properties?city=Miami&listingType=SALE&minPrice=500000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "properties"],
              "query": [
                { "key": "city", "value": "Miami" },
                { "key": "listingType", "value": "SALE" },
                { "key": "minPrice", "value": "500000" }
              ]
            }
          }
        },
        {
          "name": "Get Property By ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/properties/1", "host": ["{{baseUrl}}"], "path": ["api", "properties", "1"] }
          }
        },
        {
          "name": "Create Property Listing",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Luxury Waterfront Penthouse\",\n  \"description\": \"Stunning bay view penthouse.\",\n  \"propertyType\": \"APARTMENT\",\n  \"listingType\": \"SALE\",\n  \"price\": 1250000,\n  \"city\": \"Miami\",\n  \"state\": \"FL\",\n  \"bedrooms\": 3,\n  \"bathrooms\": 3,\n  \"areaSqFt\": 2400\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/properties", "host": ["{{baseUrl}}"], "path": ["api", "properties"] }
          }
        }
      ]
    },
    {
      "name": "Visits & Tours",
      "item": [
        {
          "name": "Schedule Visit",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"propertyId\": 1,\n  \"visitDate\": \"2026-11-15\",\n  \"timeSlot\": \"10:00 AM - 11:00 AM\",\n  \"notes\": \"Interested in touring master suite.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/visits", "host": ["{{baseUrl}}"], "path": ["api", "visits"] }
          }
        },
        {
          "name": "My Visits",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/visits/my", "host": ["{{baseUrl}}"], "path": ["api", "visits", "my"] }
          }
        }
      ]
    },
    {
      "name": "Admin Management",
      "item": [
        {
          "name": "Dashboard Metrics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/stats", "host": ["{{baseUrl}}"], "path": ["api", "admin", "stats"] }
          }
        },
        {
          "name": "Pending Agent Verifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/agents/pending", "host": ["{{baseUrl}}"], "path": ["api", "admin", "agents", "pending"] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "jwtToken", "value": "" },
    { "key": "adminToken", "value": "" }
  ]
}
